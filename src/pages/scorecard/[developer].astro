---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VerdictMark from '@/components/VerdictMark.astro';
import { categories } from '@/data/framework';
import { developers, RETRIEVED, type Developer } from '@/data/scorecard';
import { lastUpdated } from '@/data/site';
import { categoryScore, cellFor, overallScore, weightFor, VERDICT_LABEL } from '@/lib/score';

export function getStaticPaths() {
  return developers.map((developer) => ({
    params: { developer: developer.slug },
    props: { developer },
  }));
}

interface Props {
  developer: Developer;
}

const { developer } = Astro.props;
const overall = overallScore(developer);
const scores = categories.map((c) => categoryScore(developer, c.slug));

// Distinct sources cited anywhere on this page, for the sources appendix.
const sourceMap = new Map<string, { source: string; publisher: string; url: string; date: string; thirdParty?: boolean }>();
for (const cell of developer.cells) {
  for (const e of cell.evidence) {
    if (!sourceMap.has(e.url + e.source)) {
      sourceMap.set(e.url + e.source, {
        source: e.source,
        publisher: e.publisher,
        url: e.url,
        date: e.date,
        thirdParty: e.thirdParty,
      });
    }
  }
}
const sources = [...sourceMap.values()].sort((a, b) => b.date.localeCompare(a.date));

function fmtDate(iso: string): string {
  const parts = iso.split('-');
  const d = new Date(iso.length === 7 ? `${iso}-01` : iso);
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    ...(parts.length === 3 ? { day: 'numeric' } : {}),
    timeZone: 'UTC',
  });
}
---

<BaseLayout
  title={`${developer.name} — Scorecard`}
  description={`What ${developer.name} discloses about its internally deployed models, graded against all fifteen questions in the disclosure framework, with sources.`}
>
  <article class="dev">
    <header class="dev-hero">
      <div class="shell shell--wide">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/scorecard">Scorecard</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{developer.name}</span>
        </nav>

        <div class="dev-hero__grid">
          <div>
            <h1 class="dev-hero__title">{developer.name}</h1>
            <p class="dev-hero__note">{developer.note}</p>
          </div>

          <div class="dev-hero__scores">
            <div class="score-overall">
              <span class="score-overall__num tnum">{overall === null ? '—' : overall}</span>
              <span class="score-overall__pct">%</span>
              <span class="score-overall__label">overall disclosure</span>
            </div>
            <dl class="score-cats">
              {scores.map((s) => {
                const cat = categories.find((c) => c.slug === s.categorySlug)!;
                return (
                  <div class="score-cats__item">
                    <dt>{cat.name}</dt>
                    <dd class="tnum">{s.percent === null ? '—' : `${s.percent}%`}</dd>
                  </div>
                );
              })}
            </dl>
          </div>
        </div>
      </div>
    </header>

    <section class="dev-items">
      <div class="shell shell--wide">
        {categories.map((category) => (
          <div class="cat" id={category.slug}>
            <h2 class="cat__title">
              {category.name}
              <span class="cat__pct mono">
                {categoryScore(developer, category.slug).percent ?? '—'}%
              </span>
            </h2>

            {category.disclosures.map((item) => {
              const cell = cellFor(developer, item.slug);
              if (!cell) return null;
              return (
                <section class="item" id={item.slug}>
                  <div class="item__head">
                    <h3 class="item__q">
                      {item.question}
                      <a href={`#${item.slug}`} class="item__anchor" aria-label="Permalink to this question">#</a>
                    </h3>
                    <div class="item__verdict">
                      <VerdictMark verdict={cell.verdict} priority={item.priority} />
                    </div>
                  </div>

                  {item.examples && <p class="item__examples">{item.examples}</p>}
                  {item.priority && (
                    <p class="item__prio">
                      Priority disclosure — weighted ×{weightFor(item)}
                    </p>
                  )}

                  <p class="item__rationale">{cell.rationale}</p>

                  {cell.evidence.length > 0 && (
                    <div class="evidence">
                      <p class="label">
                        {cell.evidence.length === 1 ? 'Source' : 'Sources'}
                      </p>
                      <ul class="evidence__list">
                        {cell.evidence.map((e) => (
                          <li class="evidence__item">
                            {e.quote && <blockquote class="evidence__quote">{e.quote}</blockquote>}
                            <p class="evidence__cite">
                              <a href={e.url} rel="noopener">{e.source}</a>
                              <span class="evidence__meta">{` — ${e.publisher}, ${fmtDate(e.date)}`}</span>
                              {e.thirdParty && <span class="evidence__tp">third party</span>}
                            </p>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </section>
              );
            })}
          </div>
        ))}
      </div>
    </section>

    <hr class="rule" />

    <section class="dev-sources">
      <div class="shell shell--wide">
        <p class="label">Appendix</p>
        <h2 class="dev-sources__title">Every source cited on this page</h2>
        <p class="dev-sources__note">
          {sources.length} documents, retrieved {fmtDate(RETRIEVED)}. Anything
          {developer.name} published after that date is not reflected here.
          Assessments are of published material only — see the
          <a href="/scorecard/methodology#corrections">corrections policy</a>.
        </p>
        <ol class="source-list">
          {sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener">{s.source}</a>
              <span class="source-list__meta">{` — ${s.publisher}, ${fmtDate(s.date)}`}</span>
              {s.thirdParty && <span class="evidence__tp">third party</span>}
            </li>
          ))}
        </ol>

        <p class="dev-sources__foot">
          Scorecard last reviewed {lastUpdated}. Verdict scale: {' '}
          {Object.values(VERDICT_LABEL).join(' · ')}.
        </p>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .dev-hero {
    padding-block: clamp(2rem, 4vw, 3rem) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }
  .crumb {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font-size: var(--t-sm);
    color: var(--ink-3);
    margin-bottom: var(--s-6);
  }
  .crumb a { color: var(--ink-2); }
  .crumb a:hover { color: var(--accent); }
  .dev-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .dev-hero__title {
    font-size: var(--t-3xl);
    font-weight: 620;
    letter-spacing: -0.033em;
    line-height: 1.03;
    margin: 0 0 var(--s-5);
    max-width: 20ch;
  }
  .dev-hero__note {
    font-size: var(--t-md);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 58ch;
    margin: 0;
  }

  /* Score panel: one large figure with the four category readings beneath it,
     so the headline number and its components read as one object. */
  .dev-hero__scores {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: var(--s-5);
  }
  .score-overall {
    display: flex;
    align-items: baseline;
    gap: 0.1rem;
    flex-wrap: wrap;
    padding-bottom: var(--s-4);
    margin-bottom: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .score-overall__num {
    font-size: 3.25rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--ink);
  }
  .score-overall__pct {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--ink-3);
    letter-spacing: -0.02em;
  }
  .score-overall__label {
    flex-basis: 100%;
    font-size: var(--t-xs);
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-3);
    margin-top: var(--s-2);
  }
  .score-cats {
    display: grid;
    gap: var(--s-3);
    margin: 0;
  }
  .score-cats__item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .score-cats dt { font-size: var(--t-sm); color: var(--ink-2); }
  .score-cats dd { margin: 0; font-size: var(--t-base); color: var(--ink); font-weight: 500; }

  .dev-items { padding-block: var(--s-7); }

  /* Reading measure preserved inside the wide shell, so the questions share a
     left edge with the headline above rather than floating in a centred column. */
  .cat {
    margin-bottom: clamp(3rem, 6vw, 5rem);
    max-width: 54rem;
  }
  .cat__title {
    font-size: var(--t-xl);
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line-strong);
    margin-bottom: var(--s-5);
    letter-spacing: -0.022em;
  }
  .cat__num {
    color: var(--ink-3);
    font-size: var(--t-sm);
    font-weight: 500;
    min-width: 1.4rem;
  }
  .cat__pct {
    margin-left: auto;
    font-size: var(--t-md);
    font-weight: 550;
    color: var(--ink-2);
  }

  .item {
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--hairline);
  }
  .item:last-child { border-bottom: 0; }
  .item__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-5);
    flex-wrap: wrap;
  }
  .item__q {
    font-size: 1.0625rem;
    line-height: 1.4;
    margin: 0;
    flex: 1 1 20rem;
    position: relative;
  }
  /* Permalink reveals on hover or focus rather than sitting permanently
     beside every question. */
  .item__anchor {
    color: var(--ink-3);
    margin-left: var(--s-2);
    font-size: 0.875rem;
    opacity: 0;
    transition: opacity var(--d-fast) var(--ease);
  }
  .item:hover .item__anchor,
  .item__anchor:focus-visible { opacity: 1; }
  .item__anchor:hover { color: var(--accent); }
  .item__verdict { flex: 0 0 auto; }

  .item__examples {
    font-size: 0.875rem;
    color: var(--ink-muted);
    font-style: italic;
    margin: var(--s-2) 0 0;
  }
  .item__prio {
    font-size: var(--t-xs);
    font-weight: 550;
    letter-spacing: 0;
    color: var(--accent);
    margin: var(--s-3) 0 0;
  }
  .item__rationale {
    margin: var(--s-4) 0 0;
    line-height: 1.65;
  }

  .evidence {
    margin-top: var(--s-5);
    padding-left: var(--s-5);
    border-left: 1px solid var(--hairline);
  }
  .evidence__list { list-style: none; padding: 0; margin: var(--s-3) 0 0; }
  .evidence__item + .evidence__item { margin-top: var(--s-5); }
  .evidence__quote {
    margin: 0 0 var(--s-3);
    /* the one place the serif appears on this page — quoted source text */
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--ink);
    quotes: '“' '”';
  }
  .evidence__quote::before { content: open-quote; }
  .evidence__quote::after { content: close-quote; }
  .evidence__cite { margin: 0; font-size: 0.8125rem; }
  .evidence__meta { color: var(--ink-muted); }
  .evidence__tp {
    display: inline-block;
    margin-left: var(--s-2);
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-2);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 0 0.35em;
  }

  .dev-sources { padding-block: var(--s-7) var(--s-8); }
  .dev-sources__title { font-size: var(--step-2); margin: var(--s-2) 0 var(--s-3); }
  .dev-sources__note { color: var(--ink-muted); font-size: 0.9375rem; line-height: 1.6; }
  .source-list { margin: var(--s-5) 0 0; padding-left: 1.25rem; font-size: 0.875rem; }
  .source-list li { margin-bottom: var(--s-3); line-height: 1.5; }
  .source-list__meta { color: var(--ink-muted); }
  .dev-sources__foot {
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--hairline);
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .dev-hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
    .dev-hero__title { max-width: none; }
  }

  @media (max-width: 720px) {
    .score-cats { grid-template-columns: 1fr; }
  }

  @media print {
    .item { break-inside: avoid; }
    .evidence__quote { font-size: 0.875rem; }
  }
</style>
