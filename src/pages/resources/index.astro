---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  primaryTexts,
  systemCards,
  developerSources,
  literature,
  externalAuditors,
} from '@/data/resources';
import { paper, arxivLabel } from '@/data/site';

const totalResources =
  primaryTexts.length +
  systemCards.length +
  developerSources.length +
  literature.length +
  externalAuditors.length;

const bibtex = `@inproceedings{charnock2026idm,
  title     = {${paper.title}},
  author    = {Charnock, Jacob and Mehta Moreno, Raja and Miller, Justin
               and Anderson, William L.},
  booktitle = {${paper.venue}},
  year      = {2026},
  eprint    = {${paper.arxivId}},
  archivePrefix = {arXiv},
  primaryClass  = {cs.CY},
  url       = {${paper.abstractUrl}}
}`;
---

<BaseLayout
  title="Resources"
  description="Primary legal texts, frontier-lab system cards, related literature, and external auditors referenced in the paper."
>
  <article class="resources">
    <!-- ===== Hero ===== -->
    <header class="rs-hero">
      <div class="shell shell--wide">
        <h1 class="rs-hero__title">The reading list behind the framework</h1>
        <p class="lede">
          {totalResources} primary texts and references, organised by how they relate to
          internal-deployment disclosure — the paper's bibliography, the legal instruments,
          and the developer documents the <a href="/scorecard">scorecard</a> grades.
        </p>
      </div>
    </header>

    <hr class="rule rule-strong" />

    <!-- ===== Section: primary texts ===== -->
    <section class="rs-section" id="primary-texts">
      <div class="shell shell--table">
        <header class="rs-section__head">
          <p class="eyebrow">A · Primary legal texts</p>
          <h2>Laws, bills, and voluntary frameworks cited in the paper</h2>
          <p class="muted rs-section__sub">
            The full landscape of {primaryTexts.length}+ instruments — graded against the
            framework — lives on the <a href="/tracker">tracker</a>. These are the five
            referenced most directly in the paper.
          </p>
        </header>
        <ul class="rs-list">
          {primaryTexts.map((r) => (
            <li class="rs-card">
              <p class="rs-card__meta caps muted">
                {r.publisher}{r.year && <> · {r.year}</>}
              </p>
              <h3 class="rs-card__title">
                <a href={r.url} target="_blank" rel="noopener noreferrer">
                  {r.title}
                  <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p class="rs-card__note">{r.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===== Section: system cards ===== -->
    <section class="rs-section" id="system-cards">
      <div class="shell shell--table">
        <header class="rs-section__head">
          <p class="eyebrow">B · Frontier-lab disclosures</p>
          <h2>System cards and risk reports</h2>
          <p class="muted rs-section__sub">
            Existing public disclosures from frontier labs — useful as reference points for what
            voluntary IDM disclosure can already cover.
          </p>
        </header>
        <ul class="rs-list">
          {systemCards.map((r) => (
            <li class="rs-card">
              <p class="rs-card__meta caps muted">
                {r.publisher}{r.year && <> · {r.year}</>}
              </p>
              <h3 class="rs-card__title">
                <a href={r.url} target="_blank" rel="noopener noreferrer">
                  {r.title}
                  <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p class="rs-card__note">{r.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===== Section: developer sources graded by the scorecard ===== -->
    <section class="rs-section" id="developer-sources">
      <div class="shell shell--table">
        <header class="rs-section__head">
          <p class="eyebrow">C · The scorecard's evidence base</p>
          <h2>Developer documents that address internal deployment</h2>
          <p class="muted rs-section__sub">
            Every document cited by the <a href="/scorecard">scorecard</a>, in one place. These
            are the sources in which a developer either answers one of the framework's fifteen
            questions or does not.
          </p>
        </header>
        <ul class="rs-list">
          {developerSources.map((r) => (
            <li class="rs-card">
              <p class="rs-card__meta caps muted">
                {r.publisher}{r.year && <> · {r.year}</>}
              </p>
              <h3 class="rs-card__title">
                {r.url ? (
                  <a href={r.url} target="_blank" rel="noopener noreferrer">
                    {r.title}
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  r.title
                )}
              </h3>
              <p class="rs-card__note">{r.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===== Section: literature ===== -->
    <section class="rs-section" id="literature">
      <div class="shell shell--table">
        <header class="rs-section__head">
          <p class="eyebrow">D · Related literature</p>
          <h2>Works that informed the framework</h2>
          <p class="muted rs-section__sub">
            The research and policy literature on internal deployment, AI R&amp;D automation,
            verifiable claims, and frontier-lab auditing.
          </p>
        </header>
        <ol class="rs-bib">
          {literature.map((r) => (
            <li class="rs-bib__item">
              <div class="rs-bib__cite">
                {r.authors && <span class="rs-bib__authors">{r.authors}</span>}
                <span class="rs-bib__sep" aria-hidden="true">·</span>
                <span class="rs-bib__year mono">{r.year}</span>
              </div>
              <p class="rs-bib__title">
                {r.url ? (
                  <a href={r.url} target="_blank" rel="noopener noreferrer">{r.title}</a>
                ) : (
                  r.title
                )}
              </p>
              <p class="rs-bib__pub muted">
                {r.publisher}
              </p>
              <p class="rs-bib__note">{r.note}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ===== Section: third parties ===== -->
    <section class="rs-section" id="auditors">
      <div class="shell shell--table">
        <header class="rs-section__head">
          <p class="eyebrow">E · External evaluators</p>
          <h2>Third parties for confidential channels</h2>
          <p class="muted rs-section__sub">
            Organisations that already receive sensitive information about internal deployments
            under structured arrangements — relevant to the paper's "trusted third party"
            disclosure pathway.
          </p>
        </header>
        <ul class="rs-list">
          {externalAuditors.map((r) => (
            <li class="rs-card">
              <p class="rs-card__meta caps muted">{r.publisher}</p>
              <h3 class="rs-card__title">
                <a href={r.url} target="_blank" rel="noopener noreferrer">
                  {r.title}
                  <span aria-hidden="true">↗</span>
                </a>
              </h3>
              <p class="rs-card__note">{r.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===== Section: citing ===== -->
    <section class="rs-section" id="cite">
      <div class="shell shell--table">
        <header class="rs-section__head">
          <p class="eyebrow">F · Citing this work</p>
          <h2>Citation and bibliography</h2>
          <p class="muted rs-section__sub">
            Cite the paper, not this site. The full bibliography is available as BibTeX for
            anyone building on the framework.
          </p>
        </header>

        <div class="cite-block">
          <p class="cite-block__plain">
            Charnock, J., Mehta Moreno, R., Miller, J., &amp; Anderson, W.&nbsp;L. (2026).
            <em>{paper.title}</em> {paper.venue}. {arxivLabel}.
          </p>

          <pre class="cite-block__bibtex mono"><code>{bibtex}</code></pre>

          <p class="cite-block__links">
            <a href="/internaldeployments.bib" download>
              Full bibliography (.bib) <span aria-hidden="true">↓</span>
            </a>
            <span aria-hidden="true">·</span>
            <a href={paper.abstractUrl}>arXiv abstract <span aria-hidden="true">↗</span></a>
            <span aria-hidden="true">·</span>
            <a href={paper.pdfUrl}>Paper PDF</a>
          </p>
        </div>
      </div>
    </section>

    <hr class="rule rule-strong" />

    <!-- ===== Contact ===== -->
    <section class="rs-contact">
      <div class="shell shell--prose">
        <p class="eyebrow">Feedback &amp; corrections</p>
        <h2>Suggest a resource or correction</h2>
        <p>
          This site is a working reference. If you've spotted a missing instrument, a stale
          link, an error in the tracker assessment, or have an addition for the reading list —
          let us know.
        </p>
        <p>
          The tracker is refreshed quarterly. Substantive changes are logged in the
          <a href="https://github.com/nomads/IDM/commits/main" target="_blank" rel="noopener noreferrer">
            site changelog
          </a>.
        </p>
        <div class="rs-contact__actions">
          <a
            href="https://github.com/nomads/IDM/issues/new"
            class="btn btn--primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open an issue
          </a>
          <a
            href="mailto:idm-disclosure@example.org"
            class="btn btn--ghost"
          >
            Email the editors
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  /* ===== Hero ============================================== */
  .rs-hero { padding-block: var(--s-8) var(--s-7); }
  .rs-hero__title {
    font-size: var(--t-3xl);
    font-weight: 620;
    letter-spacing: -0.033em;
    line-height: 1.03;
    margin: 0 0 var(--s-5);
    max-width: 20ch;
  }

  /* ===== Section heads ===================================== */
  .rs-section { padding-block: var(--s-7); border-top: 1px solid var(--hairline); }
  .rs-section:first-of-type { border-top: 0; }
  .rs-section__head { margin-bottom: var(--s-6); max-width: 44rem; }
  .rs-section__head h2 {
    font-size: var(--step-2);
    font-weight: 400;
    margin: var(--s-2) 0 var(--s-3);
    letter-spacing: -0.02em;
  }
  .rs-section__sub { max-width: 36rem; margin: 0; }

  /* ===== Cards (primary texts, system cards, auditors) ===== */
  .rs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-5);
    max-width: none;
  }
  .rs-card {
    margin: 0;
    padding: var(--s-5);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--paper-raised);
    transition: border-color var(--d-fast) var(--ease-out);
  }
  .rs-card:hover { border-color: var(--hairline-strong); }
  .rs-card__meta {
    margin: 0 0 var(--s-3);
    font-size: 0.6875rem;
  }
  .rs-card__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin: 0 0 var(--s-3);
    text-wrap: balance;
  }
  .rs-card__title a {
    color: var(--ink);
    border-bottom: 0;
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    transition: color var(--d-fast) var(--ease-out);
  }
  .rs-card__title a:hover { color: var(--accent); }
  .rs-card__title a span {
    font-size: 0.875rem;
    color: var(--ink-faint);
  }
  .rs-card__note {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    max-width: none;
  }
  @media (max-width: 720px) {
    .rs-list { grid-template-columns: 1fr; }
  }

  /* ===== Bibliography (literature) ========================= */
  .rs-bib {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: bib;
    max-width: none;
  }
  .rs-bib__item {
    counter-increment: bib;
    position: relative;
    padding: var(--s-5) 0 var(--s-5) 3rem;
    border-top: 1px solid var(--hairline);
    margin: 0;
    max-width: 44rem;
  }
  .rs-bib__item:last-child { border-bottom: 1px solid var(--hairline); }
  .rs-bib__item::before {
    content: counter(bib, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: var(--s-5);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
  .rs-bib__cite {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    flex-wrap: wrap;
    margin-bottom: var(--s-2);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .rs-bib__authors { color: var(--ink); }
  .rs-bib__sep { color: var(--ink-faint); }
  .rs-bib__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
    margin: 0 0 var(--s-2);
    max-width: none;
    text-wrap: pretty;
  }
  .rs-bib__title a {
    color: var(--ink);
    border-bottom: 1px solid var(--hairline-strong);
    transition: border-color var(--d-fast) var(--ease-out), color var(--d-fast) var(--ease-out);
  }
  .rs-bib__title a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .rs-bib__pub {
    margin: 0 0 var(--s-2);
    font-size: 0.8125rem;
  }
  .rs-bib__note {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-muted);
    line-height: 1.55;
    max-width: none;
  }

  /* ===== Contact =========================================== */
  .rs-contact { padding-block: var(--s-7) var(--s-8); }
  .rs-contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }
  .btn {
    display: inline-flex; align-items: center; gap: var(--s-2);
    padding: 0.625rem 1.125rem; border-radius: var(--r-pill);
    font-size: 0.9375rem; font-weight: 500; border-bottom: 0;
    transition: all var(--d-fast) var(--ease-out);
  }
  .btn--primary { background: var(--ink); color: var(--paper); border: 1px solid var(--ink); }
  .btn--primary:hover { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  .btn--ghost { color: var(--ink-muted); border: 1px solid var(--hairline-strong); }
  .btn--ghost:hover { color: var(--ink); border-color: var(--ink-muted); }

  /* ===== Citation block ==================================== */
  .cite-block { max-width: 46rem; }
  .cite-block__plain {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: var(--s-5);
  }
  .cite-block__bibtex {
    margin: 0;
    padding: var(--s-5);
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
    background: var(--accent-soft);
    font-size: 0.75rem;
    line-height: 1.6;
    overflow-x: auto;
    white-space: pre;
    color: var(--ink);
  }
  .cite-block__links {
    margin-top: var(--s-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: center;
    font-size: 0.875rem;
  }
</style>
