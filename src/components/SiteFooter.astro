---
import { paper, lastUpdated, arxivLabel } from '@/data/site';
---

<footer class="site-footer no-print">
  <div class="shell shell--wide site-footer__inner">
    <div class="site-footer__col">
      <p class="label">Citation</p>
      <p class="cite">
        Charnock, J., Mehta Moreno, R., Miller, J., &amp; Anderson, W.&nbsp;L. (2026).
        <em>{paper.title}</em> {paper.venue}. {arxivLabel}.
      </p>
      <p class="cite-links">
        <a href={paper.abstractUrl}>arXiv abstract</a>
        <span aria-hidden="true" class="faint">·</span>
        <a href={paper.pdfUrl}>PDF</a>
        <span aria-hidden="true" class="faint">·</span>
        <a href="/resources#cite">BibTeX</a>
      </p>
    </div>

    <div class="site-footer__col">
      <p class="label">About this site</p>
      <p class="about">
        An independent reference resource for the paper. The scorecard and tracker are
        editorial assessments of published material — not legal advice, and not audits.
        Corrections are welcome; see the
        <a href="/scorecard/methodology#corrections">corrections policy</a>. Refreshed
        quarterly to align with SB&nbsp;53 OES reporting cycles.
      </p>
    </div>

    <div class="site-footer__col site-footer__meta">
      <p class="label">Last updated</p>
      <p class="tnum">{lastUpdated}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1.4fr) auto;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .site-footer__col p {
    max-width: 38ch;
    font-size: var(--t-base);
    line-height: 1.55;
  }
  .site-footer__col .label {
    max-width: none;
  }
  .cite {
    color: var(--ink);
  }
  .cite em {
    font-style: italic;
  }
  .cite-links {
    margin-top: var(--s-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: baseline;
    font-size: var(--t-sm);
  }
  .cite-links a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
  }
  .cite-links a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .site-footer__meta {
    text-align: right;
  }
  .site-footer__meta p {
    max-width: none;
  }
  @media (max-width: 820px) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
    .site-footer__meta {
      text-align: left;
    }
  }
</style>
