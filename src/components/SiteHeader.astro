---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/framework', label: 'Framework' },
  { href: '/scorecard', label: 'Scorecard' },
  { href: '/tracker', label: 'Tracker' },
  { href: '/checklist', label: 'Templates' },
  { href: '/resources', label: 'Resources' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header no-print">
  <div class="shell shell--wide site-header__inner">
    <a href="/" class="brand" aria-label="Internal Deployments — home">
      <span class="brand__name">Internal&nbsp;Deployments</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['site-nav__link', { 'is-active': pathname.startsWith(link.href) }]}
              aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__end">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-6);
    padding-block: 0.85rem;
  }

  /* Wordmark set in type. The name is the mark — no symbol standing in for it. */
  .brand {
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.017em;
    white-space: nowrap;
  }
  .brand__name {
    background-image: linear-gradient(var(--ink), var(--ink));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size var(--d-base) var(--ease);
    padding-bottom: 2px;
  }
  .brand:hover .brand__name {
    background-size: 100% 1px;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--s-5);
    justify-content: flex-end;
    max-width: none;
  }
  .site-nav__link {
    position: relative;
    display: block;
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 450;
    letter-spacing: -0.008em;
    padding-block: 0.35rem;
    transition: color var(--d-fast) var(--ease);
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.87rem;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transition: transform var(--d-base) var(--ease);
  }
  .site-nav__link:hover {
    color: var(--ink);
  }
  .site-nav__link.is-active {
    color: var(--ink);
    font-weight: 550;
  }
  .site-nav__link.is-active::after {
    transform: scaleX(1);
  }

  .site-header__end {
    display: flex;
    align-items: center;
    justify-self: end;
    padding-left: var(--s-5);
    margin-left: calc(-1 * var(--s-1));
    border-left: 1px solid var(--line);
    align-self: stretch;
  }

  @media (max-width: 860px) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: var(--s-2) var(--s-4);
      padding-block: 0.7rem;
    }
    .site-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .site-nav::-webkit-scrollbar {
      display: none;
    }
    .site-nav ul {
      gap: var(--s-5);
      justify-content: flex-start;
      white-space: nowrap;
    }
    .site-nav__link::after {
      bottom: -0.1rem;
    }
  }
</style>
