---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/framework', label: 'Framework' },
  { href: '/scorecard', label: 'Scorecard' },
  { href: '/tracker', label: 'Tracker' },
  { href: '/checklist', label: 'Templates' },
  { href: '/resources', label: 'Resources' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header no-print">
  <div class="shell shell--table site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Internal Deployments home">
      <span class="brand-mark" aria-hidden="true">§</span>
      <span class="brand-name">Internal Deployments</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['site-nav__link', { 'is-active': pathname.startsWith(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__end">
      <ThemeToggle />
    </div>
  </div>
  <hr class="rule" />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-4);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--ink);
    border-bottom: 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .brand-mark {
    font-family: var(--font-display);
    color: var(--citation);
    font-size: 1.25rem;
    line-height: 1;
    transform: translateY(1px);
  }
  .brand-name {
    border-bottom: 1px solid transparent;
    transition: border-color var(--d-fast) var(--ease-out);
  }
  .site-header__brand:hover .brand-name {
    border-bottom-color: var(--ink);
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--s-5);
    justify-content: center;
    max-width: none;
  }
  .site-nav__link {
    color: var(--ink-muted);
    border-bottom: 1px solid transparent;
    font-size: 0.9375rem;
    padding-block: var(--s-1);
    transition: color var(--d-fast) var(--ease-out), border-color var(--d-fast) var(--ease-out);
  }
  .site-nav__link:hover {
    color: var(--ink);
    border-bottom-color: var(--hairline-strong);
  }
  .site-nav__link.is-active {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .site-header__end {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    justify-self: end;
  }
  @media (max-width: 720px) {
    .site-header__inner {
      grid-template-columns: auto auto;
      grid-template-rows: auto auto;
      gap: var(--s-3);
    }
    .site-nav {
      grid-column: 1 / -1;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--s-4));
      padding-inline: var(--s-4);
    }
    .site-nav ul {
      gap: var(--s-4);
      justify-content: flex-start;
      white-space: nowrap;
    }
  }
</style>
