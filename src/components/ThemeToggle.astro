---
// Theme toggle. Persists to localStorage, respects system preference,
// updates document.documentElement[data-theme]. Inline script to avoid FOUC.
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Toggle color theme"
  data-theme-toggle
>
  <svg class="icon icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
  <svg class="icon icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
  </svg>
</button>

<style>
  .theme-toggle {
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--ink-muted);
    transition: color var(--d-fast) var(--ease-out), border-color var(--d-fast) var(--ease-out);
    padding: 0;
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--hairline-strong);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .icon-moon { display: none; }
  :global([data-theme='dark']) .icon-sun { display: none; }
  :global([data-theme='dark']) .icon-moon { display: inline-block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .icon-sun { display: none; }
    :global(:root:not([data-theme])) .icon-moon { display: inline-block; }
  }
</style>

<script>
  // toggle handler
  const button = document.querySelector('[data-theme-toggle]');
  if (button) {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const current =
        root.getAttribute('data-theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('idm-theme', next);
      } catch (_) {}
    });
  }
</script>
