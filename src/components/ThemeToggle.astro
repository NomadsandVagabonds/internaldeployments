---
// Theme toggle. Persists to localStorage, respects system preference.
// A text control rather than a sun/moon icon in a circle — the label says what
// it does, and it sits in the type system with everything else.
---

<button type="button" class="theme-toggle" data-theme-toggle>
  <span class="theme-toggle__label" data-theme-label>Dark</span>
  <span class="sr-only">Switch colour theme</span>
</button>

<style>
  .theme-toggle {
    background: transparent;
    border: 0;
    padding: 0.35rem 0;
    cursor: pointer;
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 450;
    letter-spacing: -0.005em;
    transition: color var(--d-fast) var(--ease);
  }
  .theme-toggle:hover {
    color: var(--ink);
  }
</style>

<script>
  const KEY = 'idm-theme';
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = document.querySelector<HTMLElement>('[data-theme-label]');

  const resolved = () =>
    document.documentElement.getAttribute('data-theme') ||
    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  // The control names the theme it switches TO, not the one you are in.
  const sync = () => {
    if (label) label.textContent = resolved() === 'dark' ? 'Light' : 'Dark';
  };

  sync();

  button?.addEventListener('click', () => {
    const next = resolved() === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem(KEY, next);
    } catch {}
    sync();
  });

  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (!document.documentElement.hasAttribute('data-theme')) sync();
    });
</script>
